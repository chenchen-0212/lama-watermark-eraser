# 构建产物
build/*
*.exe

# 发布用安装器
# 注意：安装器（约 301 MB/个）**不入库**——GitHub 单文件硬上限 100 MB，
# 提交后必然被拒。发布走 GitHub Release 附件上传。
# 历史遗留：1.1.2 曾被提交进版本库，为保持历史完整不回删，
# 但 1.1.3 及以后一律不再入库。
build/installer/*
!build/installer/.gitkeep

# 前端依赖与构建
node_modules/
frontend/dist/

# 系统文件
.DS_Store
Thumbs.db
*.log

# Python 引擎
__pycache__/
*.pyc
python_engine/venv/
python_engine/build/
python_engine/dist/
# 权重文件（205MB，走 LAMA_MODEL_SRC 注入，不入库）
python_engine/big-lama.pt
